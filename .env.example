# Copy to .env and fill in. Never commit .env.
# Development works without a .env file (emails go to Mailpit, Google login is off);
# the values below marked "production" are required there.

# --- Production ---

# Public domain of the app. HTTPS is served by the front proxy on the VM (Tornei's Caddy),
# which forwards it to this app's web container: see docs/deploy.md.
DOMAIN=wind.example.com

# Localhost port of the web container that the front proxy forwards to (default: 8081).
WEB_PORT=8081

# MongoDB Atlas connection string (Atlas → Connect → Drivers): same cluster as Tornei, its own
# database `windfinder` after the host (without it the data goes to a database called "test").
# URL-encode special characters in the password (e.g. @ → %40). Development uses its own container.
MONGODB_URI=mongodb+srv://windfinder:<password>@<cluster>.mongodb.net/windfinder?retryWrites=true&w=majority

# Image tag to pull from ghcr.io (default: latest). The deploy job pins each release to its commit SHA.
IMAGE_TAG=latest

# Days of daily MongoDB backups kept in ./backups next to the compose file (default: 14).
BACKUP_KEEP_DAYS=14

# --- Authentication ---

# Signs sessions and encrypts OAuth tokens. Required in production; at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Registration is invite-only (the admin's Invites page); there is no switch to open it.

# Google login (optional: the "Continue with Google" button fails if these are empty).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials with redirect URI
#   <app URL>/api/auth/callback/google   (dev: http://localhost:5174/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (production; development uses Mailpit) ---

# Any SMTP server works; switching provider only means changing these values.
SMTP_HOST=smtp.example.com
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in verification and password-reset emails
MAIL_FROM=Wind Finder <no-reply@wind.example.com>

# --- Data sources ---

# MeteoNetwork STANDARD token (free account at https://my.meteonetwork.it). Get it once with
#   curl -X POST https://api.meteonetwork.it/v3/login -F email=<email> -F password=<password>
# and paste the access_token here: it never expires. Empty: MeteoNetwork stations are off.
METEONETWORK_TOKEN=

# Windy Stations API key (free, https://stations.windy.com/keys), for open-data stations.
# Empty: Windy stations are off.
WINDY_API_KEY=
